---
import { getDictionary, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const home = `/${lang}/`;
---

<section class="hero" id="hero">
	<div class="container hero-grid">
		<div>
			<span class="eyebrow">{t.hero.eyebrow}</span>
			<h1>{t.hero.title}</h1>
			<p class="lede">{t.hero.lede}</p>
			<p class="hero-tools">{t.hero.toolsLabel} <b>{t.hero.tools}</b></p>
			<div class="btn-row">
				<a href={`${home}#contact`} class="btn btn-primary">{t.hero.ctaPrimary}</a>
				<a href={`${home}#how-it-works`} class="btn btn-ghost">{t.hero.ctaSecondary}</a>
			</div>
		</div>

		<div>
			<div class="flow-visual">
				<svg viewBox="0 0 520 300" role="img" aria-labelledby="heroFlowTitle">
					<title id="heroFlowTitle"
						>Diagram: a website form submission flows through AI qualification, n8n, a CRM, Slack/Email
						and reporting</title
					>
					<path class="flow-line flow-anim" d="M75,50 H190" />
					<path class="flow-line flow-anim" d="M265,50 H380 V115" />
					<path class="flow-line flow-anim" d="M380,150 V190 H265" />
					<path class="flow-line flow-anim" d="M190,225 H75 V190" />
					<path class="flow-line flow-anim" d="M75,155 V120" />

					<rect class="flow-node" x="10" y="30" width="130" height="40" rx="8"></rect>
					<text class="flow-label" x="75" y="46" text-anchor="middle">Website Form</text>
					<text class="flow-sub" x="75" y="60" text-anchor="middle">trigger</text>

					<rect class="flow-node flow-node-active" x="195" y="30" width="70" height="40" rx="8"></rect>
					<text class="flow-label" x="230" y="46" text-anchor="middle">AI</text>
					<text class="flow-sub" x="230" y="60" text-anchor="middle">qualify</text>

					<rect class="flow-node flow-node-active" x="345" y="95" width="70" height="40" rx="8"></rect>
					<text class="flow-label" x="380" y="111" text-anchor="middle">n8n</text>
					<text class="flow-sub" x="380" y="125" text-anchor="middle">orchestrate</text>

					<rect class="flow-node" x="345" y="170" width="70" height="40" rx="8"></rect>
					<text class="flow-label" x="380" y="186" text-anchor="middle">CRM</text>
					<text class="flow-sub" x="380" y="200" text-anchor="middle">record</text>

					<rect class="flow-node" x="185" y="205" width="90" height="40" rx="8"></rect>
					<text class="flow-label" x="230" y="221" text-anchor="middle">Slack / Email</text>
					<text class="flow-sub" x="230" y="235" text-anchor="middle">notify</text>

					<rect class="flow-node" x="10" y="150" width="130" height="40" rx="8"></rect>
					<text class="flow-label" x="75" y="166" text-anchor="middle">Reporting</text>
					<text class="flow-sub" x="75" y="180" text-anchor="middle">result</text>
				</svg>
				<p class="flow-caption">{t.hero.flowCaption}</p>
			</div>
		</div>
	</div>
</section>
