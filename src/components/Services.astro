---
import { getDictionary, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="services">
	<div class="container">
		<span class="eyebrow">{t.services.eyebrow}</span>
		<h2>{t.services.title}</h2>
		<p class="lede">{t.services.lede}</p>

		<div class="svc-grid">
			{
				t.services.items.map((item) => (
					<div class="svc-card">
						<h3>{item.title}</h3>
						<p>{item.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
