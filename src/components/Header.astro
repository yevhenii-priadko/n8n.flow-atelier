---
import Icon from './Icon.astro';
import { getDictionary, getAlternateUrl, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const home = `/${lang}/`;
const urlFor = (target: Locale) => (target === lang ? home : getAlternateUrl(Astro.url.pathname, target));

const links = [
	{ href: '#services', label: t.nav.services },
	{ href: '#technologies', label: t.nav.technologies },
	{ href: '#example', label: t.nav.useCases },
	{ href: '#approach', label: t.nav.howItWorks },
	{ href: '#contact', label: t.nav.contact },
];
const langs: { code: Locale; label: string }[] = [
	{ code: 'uk', label: 'UA' },
	{ code: 'en', label: 'EN' },
];
---

<header class="site" id="siteHeader">
	<div class="container nav">
		<a href={home} class="brand">
			<img src="/logo-mark.png" alt="" class="brand-mark" width="32" height="40" />
			{t.brand}
		</a>

		<nav class="nav-menu" aria-label={t.nav.menu}>
			<ul class="nav-links" id="navLinks">
				{
					links.map((l) => (
						<li>
							<a href={`${home}${l.href}`}>{l.label}</a>
						</li>
					))
				}
				<li class="nav-links-cta">
					<a href={`${home}#contact`} class="btn btn-primary">
						{t.nav.cta}
						<Icon name="arrow-right" size={18} />
					</a>
				</li>
			</ul>
		</nav>

		<div class="nav-right">
			<div class="lang-switch" role="group" aria-label="Language">
				{
					langs.map((l) => (
						<a href={urlFor(l.code)} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
							{l.label}
						</a>
					))
				}
			</div>
			<a href={`${home}#contact`} class="btn btn-primary nav-cta">
				{t.nav.cta}
				<Icon name="arrow-right" size={18} />
			</a>
			<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="navLinks" id="navToggle" aria-label={t.nav.menu}>
				<Icon name="menu" size={22} class="nav-toggle-open" />
				<Icon name="x" size={22} class="nav-toggle-close" />
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('siteHeader');
	const navToggle = document.getElementById('navToggle');
	const navLinks = document.getElementById('navLinks');

	const setOpen = (open: boolean) => {
		navLinks?.classList.toggle('open', open);
		navToggle?.setAttribute('aria-expanded', String(open));
	};

	navToggle?.addEventListener('click', () => setOpen(!navLinks?.classList.contains('open')));
	navLinks?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && navLinks?.classList.contains('open')) {
			setOpen(false);
			navToggle?.focus();
		}
	});

	const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
</script>
