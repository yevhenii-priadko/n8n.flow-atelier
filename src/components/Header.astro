---
import { getDictionary, getAlternateUrl, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const altUrl = getAlternateUrl(Astro.url.pathname, lang === 'en' ? 'uk' : 'en');
const home = `/${lang}/`;
---

<header class="site">
	<div class="container nav">
		<a href={home} class="brand">
			<img src="/logo-mark.png" alt="" class="brand-mark" width="32" height="40" />
			{t.brand}
		</a>

		<ul class="nav-links" id="navLinks">
			<li><a href={`${home}#services`}>{t.nav.services}</a></li>
			<li><a href={`${home}#who-we-help`}>{t.nav.solutions}</a></li>
			<li><a href={`${home}#how-it-works`}>{t.nav.howItWorks}</a></li>
			<li><a href={`${home}#technologies`}>{t.nav.technologies}</a></li>
			<li><a href={`${home}#use-cases`}>{t.nav.useCases}</a></li>
			<li><a href={`${home}#faq`}>{t.nav.faq}</a></li>
			<li><a href={`${home}#contact`}>{t.nav.contact}</a></li>
			<li><a href={`${home}#contact`}>{t.nav.cta}</a></li>
		</ul>

		<div class="nav-right">
			<div class="lang-switch" role="group" aria-label="Language">
				<a href={lang === 'en' ? home : altUrl} aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
				<a href={lang === 'uk' ? home : altUrl} aria-current={lang === 'uk' ? 'true' : 'false'}>UA</a>
			</div>
			<button class="nav-toggle" aria-expanded="false" aria-controls="navLinks" id="navToggle" aria-label="Toggle navigation">☰</button>
		</div>
	</div>
</header>

<script>
	const navToggle = document.getElementById('navToggle');
	const navLinks = document.getElementById('navLinks');
	navToggle?.addEventListener('click', () => {
		const isOpen = navLinks?.classList.toggle('open');
		navToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
	navLinks?.querySelectorAll('a').forEach((a) => {
		a.addEventListener('click', () => navLinks.classList.remove('open'));
	});
</script>
