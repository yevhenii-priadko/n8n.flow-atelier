---
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const icons = ['store', 'rocket', 'trending-up', 'cog', 'briefcase', 'layers'];
---

<section class="section" id="who-we-help">
	<div class="container">
		<div class="section-head">
			<span class="eyebrow">{t.whoWeHelp.eyebrow}</span>
			<h2>{t.whoWeHelp.title}</h2>
		</div>
		<ul class="who-grid">
			{
				t.whoWeHelp.items.map((item, i) => (
					<li class="who-card">
						<span class="card-icon">
							<Icon name={icons[i]} size={22} />
						</span>
						<div>
							<h3>{item.title}</h3>
							<p>{item.desc}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
