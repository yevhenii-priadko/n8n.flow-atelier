---
import { getDictionary, type Locale } from '../i18n/utils';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id="use-cases">
	<div class="container">
		<span class="eyebrow">{t.useCases.eyebrow}</span>
		<h2>{t.useCases.title}</h2>
		<div class="uc-grid">
			{t.useCases.items.map((item) => <div class="uc-item">{item}</div>)}
		</div>
	</div>
</section>
