# Copy to .env for local testing. In production set these in Vercel → Settings → Environment Variables (then redeploy).

# Where the contact form posts its JSON:
#   - n8n:        your workflow's Production webhook URL, e.g. https://your-n8n.example.com/webhook/lead
#   - Web3Forms:  https://api.web3forms.com/submit
PUBLIC_FORM_ENDPOINT=

# Only for Web3Forms: the access key it emails you after you enter your address on web3forms.com.
# Leave empty when using n8n.
PUBLIC_WEB3FORMS_KEY=
